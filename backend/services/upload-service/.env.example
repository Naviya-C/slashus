# Kafka + topic are also set directly in docker-compose.yml's `environment:`
# block (kept here too so the service still runs standalone outside compose).
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
UPLOAD_TOPIC=documents.uploaded

STORAGE_PROVIDER=gcs
GCS_BUCKET=slashus-upload-service-pdf
GOOGLE_APPLICATION_CREDENTIALS=/tmp/service-account.json
