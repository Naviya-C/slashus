SERVICE_HOST=0.0.0.0
SERVICE_PORT=8003
LOG_LEVEL=INFO

STORAGE_BACKEND=gcs
LOCAL_STORAGE_ROOT=/tmp/slashus-storage
SOURCE_BUCKET=slashus-source-documents
ASSET_BUCKET=slashus-document-assets
STORAGE_PREFIX=

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_UPLOAD_TOPIC=documents.uploaded
KAFKA_CHUNKS_TOPIC=documents.chunks
KAFKA_IMAGE_TOPIC=documents.images
KAFKA_COMPLETED_TOPIC=documents.ingested
KAFKA_DLQ_TOPIC=documents.uploaded.dlq
KAFKA_IMAGE_DLQ_TOPIC=documents.images.dlq
KAFKA_GROUP_ID=ingestion-service
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_USE_GCP_ADC=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_MAX_POLL_INTERVAL_MS=1800000
KAFKA_MAX_DOCUMENT_ATTEMPTS=3
KAFKA_LINGER_MS=25

REDIS_URL=redis://redis:6379/0
JOB_TTL_SECONDS=604800

CHUNK_MAX_TOKENS=720
CHUNK_OVERLAP_TOKENS=80
MAX_DOCUMENT_BYTES=209715200
MAX_DOCUMENT_UNITS=2000

OCR_ENABLED=true
OCR_LANGUAGES=eng+sin
OCR_DPI=200
OCR_TIMEOUT_SECONDS=45
OCR_MIN_TEXT_CHARACTERS=80

EXTRACT_IMAGES=true
MIN_IMAGE_WIDTH=120
MIN_IMAGE_HEIGHT=120
MIN_IMAGE_AREA_RATIO=0.02
MAX_IMAGES_PER_UNIT=8

VISION_ENRICHMENT_ENABLED=false
VISION_MODEL=gemini-2.5-flash
VISION_REQUESTS_PER_MINUTE=10
VISION_MAX_ATTEMPTS=3
VISION_CIRCUIT_SECONDS=90
GEMINI_API_KEY=