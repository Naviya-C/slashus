ENVIRONMENT=local

QDRANT_ENDPOINT=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=
# NEW collection: the Sinhala-aware hashed sparse encoder is not compatible
# with vectors written by any previous encoder.
QDRANT_COLLECTION=sinhala_books_v5

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CHUNKS_TOPIC=documents.chunks
KAFKA_DLQ_TOPIC=documents.chunks.dlq
KAFKA_BATCH_SIZE=32

EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ONNX_THREADS=2
EMBEDDING_INFERENCE_WORKERS=2
# int8: ~half the memory, faster CPU inference, small recall cost.
EMBEDDING_QUANTIZED=false

SPARSE_NUM_BUCKETS=1048576
RETRIEVAL_OVERSAMPLE=3.0
RETRIEVAL_DIVERSITY_THRESHOLD=0.8
RETRIEVAL_TITLE_CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_TITLE_WEIGHT=0.8
RETRIEVAL_GLOBAL_WEIGHT=0.2

# Shared with agentic-service; increments document cache generations after ingest.
REDIS_URL=redis://localhost:6379/0

HTTP_PORT=8004
GRPC_PORT=50051
GRPC_SERVICE_TOKEN=
LOG_LEVEL=INFO
LOG_FORMAT=json
