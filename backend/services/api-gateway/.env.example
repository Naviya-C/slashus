PORT=8080

# --- token verification: set exactly ONE ---
JWKS_URL=http://auth-service:8081/.well-known/jwks.json
# JWT_SECRET=

# Optional claim checks
# JWT_ISSUER=https://auth.slashus.app
# JWT_AUDIENCE=slashus-api

# --- backends (docker-compose service names, NOT localhost) ---
# REDIS_URL is set directly in docker-compose.yml's `environment:` block, not
# here — config.Load() hard-fails at boot if this is empty, which is exactly
# what happened before (REDIS_URL was commented out and unset).
AUTH_URL=http://auth-service:8081
UPLOAD_URL=http://upload-service:8002
INGESTION_URL=http://ingestion-service:8003
AGENTIC_URL=http://agentic:8084

AUTH_PREFIX=/api/v1/auth

RATE_LIMIT=60
RATE_WINDOW=1m
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW=1h

# --- CORS: your Vercel frontend goes here, exact origin(s), comma-separated.
# No wildcards, no trailing slash. Add both your production domain and your
# vercel.app domain if you use both.
CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

PROXY_TIMEOUT=5m
