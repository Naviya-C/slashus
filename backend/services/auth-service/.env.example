# --- database (Neon, managed Postgres — external, not a local container) ---
DATABASE_URL='postgresql://USER:PASSWORD@HOST/auth?sslmode=require&channel_binding=require'
DATABASE_URL_P='postgresql://USER:PASSWORD@HOST-pooler/auth?sslmode=require&channel_binding=require'

# --- token signing ---
JWT_ISSUER=slashus-auth
JWT_AUDIENCE=slashus-api

# DEV_MODE=true generates a fresh ephemeral RSA key EVERY container restart —
# every previously issued access/refresh token becomes invalid the moment the
# container restarts, and JWKS keys rotate under the gateway too. Fine for
# local dev. For the VM deploy, set DEV_MODE=false and provide a real,
# persistent key instead:
DEV_MODE=true
# JWT_PRIVATE_KEY_FILE=./etc/slashus/private.pem   # mount this path as a volume if used

# REDIS_URL is set in docker-compose.yml's `environment:` block for this
# service (redis://redis:6379/1), not here. It backs the login-attempt
# lockout (10 failed attempts / 15 min per email) — previously an empty
# stub, now implemented in internal/infrastructure/repository/redis_login_attempts.go.
# If unset, the service still starts but logs a warning and lockout is off.

