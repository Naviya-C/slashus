ENVIRONMENT=local

# --- Model (OpenAI-compatible endpoint; native tool calling required) ---
LLM_API_KEY=
LLM_MODEL=qwen3.6-plus
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# ONE retry layer. Nested retries multiply.
LLM_MAX_RETRIES=2

DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
# REQUIRED in production: backs working memory (checkpointer), long-term
# memory (store) and the semantic cache. Without it all three are per-process.
REDIS_URL=redis://localhost:6379/0
EMBEDDING_GRPC_URL=embedding-service:50051
EMBEDDING_SERVICE_TOKEN=

# --- Agent loop ---
AGENT_MAX_TOOL_CALLS=10
AGENT_RECURSION_LIMIT=25
AGENT_TURN_TIMEOUT_SECONDS=180
AGENT_MAX_WINDOW_TOKENS=6000
AGENT_KEEP_RECENT_MESSAGES=12

# --- Semantic response cache ---
# Greetings and follow-ups are ALWAYS answered live, by policy, regardless of
# these values. Only substantive questions are cached.
CACHE_ENABLED=true
# High on purpose: a false hit is a confidently wrong answer served instantly.
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=86400

# --- Memory ---
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_EMBED_DIMENSIONS=1024

# --- Security ---
SECURITY_GATEWAY_SHARED_SECRET=
SECURITY_RATE_LIMIT_PER_MINUTE=30

LOG_LEVEL=INFO
LOG_FORMAT=json
