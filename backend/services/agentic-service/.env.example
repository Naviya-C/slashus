# Copy to .env and fill in. Every value here is read by src/core/config/settings.py.

# --- LLM: Qwen via Alibaba Model Studio (DashScope) -------------------------
# International endpoint (Singapore). A Mainland China key will NOT work
# against it, and the error is an unhelpful 401.
QWEN_API_KEY=
QWEN_MODEL=qwen3.6-plus

# --- LLM: Gemini ------------------------------------------------------------
# Optional. Unset, the evaluator and query understanding fall back to Qwen —
# which works, but puts everything on one rate limit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- embedding-service ------------------------------------------------------
# Vector search, embeddings and the sparse vocab all live behind this. There
# are no Qdrant credentials in this service.
EMBEDDING_GRPC_URL=embedding-service:50051

# --- Persistence ------------------------------------------------------------
# A NEW database, not auth's or upload's.
DATABASE_URL=
# Agent memory lives here — conversation summary, active topic, learned
# preferences, and the previous retrieval that makes "explain more" work.
# Without it the agent still runs, but memory is per-process: with more than
# one replica a follow-up can land somewhere that never saw the previous turn.
REDIS_URL=redis://localhost:6379/2

# --- Agent loop -------------------------------------------------------------
# Hard ceiling on tool executions per turn. The agent decides what to do next;
# it does not decide how long it may keep deciding. A brain that keeps
# returning "rewrite" would otherwise bill in a tight circle.
MAX_TOOL_CALLS=8

# --- Dev --------------------------------------------------------------------
# Returns the agent's reasoning trace on each response — decisions taken,
# tools called, timings. The trace never contains chunk text, but it does
# expose internal reasoning. Never true on a deployed host.
DEV_MODE=false

# Only read by scripts/check.py — a real user id, so ListTitles is exercised.
CHECK_USER_ID=
